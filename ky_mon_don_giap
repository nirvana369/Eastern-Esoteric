            // find_khong_vong(chart_data.can_tuan_dau_index, chart_data.chi_tuan_dau_index);
            
            // 7. Arrange all elements on the chart
            arrange_palaces();

            // _addInfomation([getQimonInfo()]);

            return chart_data;
        };

