        public func tim_tuan_dau(thien_can_gio : Nat, dia_chi_gio : Nat) : {can : Nat; chi : Nat} {
            var can = thien_can_gio;
            var chi = dia_chi_gio;
            while (can != 0) {
                can := move(9, can, -1);
                chi := move(11, chi, -1);
            };

            return {
                can = can;
                chi = chi;
            };
        };

        public func tim_phu_dau(thien_can_ngay : Nat, dia_chi_ngay : Nat) : {can : Nat; chi : Nat} {
            var can = thien_can_ngay;
            var chi = dia_chi_ngay;
            if (can <= 4) {
                while (can != 0) {
                    can := move(9, can, -1);
                    chi := move(11, chi, -1);
                };
            } else {
                while (can != 5) {
                    can := move(9, can, -1);
                    chi := move(11, chi, -1);
                };
            };
            
            return {
                can = can;
                chi = chi;
            };
        };

